package com.reservas_commons.dto;

import jakarta.validation.constraints.Email;
import jakarta.validation.constraints.Max;
import jakarta.validation.constraints.Min;
import jakarta.validation.constraints.NotBlank;
import jakarta.validation.constraints.NotNull;
import jakarta.validation.constraints.Positive;
import jakarta.validation.constraints.Size;
public record HuespedRequest(
	    
	    @NotNull(message = "El id del Huésped es obligatorio")
	    @Positive(message = "El número del id Huesped debe ser positivo")
	    Long idHuesped,
	    
	    @NotBlank(message = "El nombre es obligatorio")
	    @Size(max = 50, message = "El nombre no puede exceder 50 caracteres")
	    String nombre,
	    
	    @NotBlank(message = "El apellido es obligatorio")
	    @Size(max = 50, message = "El apellido no puede exceder 50 caracteres")
	    String apellido,

	    @NotBlank(message = "El email es obligatorio")
	    @Email(message = "El email debe ser válido")
	    @Size(max = 100, message = "El email no puede exceder 100 caracteres") // Aumentado a 100
	    String email,

	    @NotBlank(message = "El telefono es obligatorio") // Cambiado a NotBlank porque es String
	    @Size(min = 10, max = 10, message = "El telefono debe tener exactamente 10 dígitos") // Correcto para String
	    String telefono,
	    
	    @NotBlank(message = "El documento es obligatorio")
	    String documento,
	    
	    @NotBlank(message = "La nacionalidad es obligatorio")
	    @Size(max = 20, message = "La nacionalidad no puede exceder 20 caracteres")
	    String nacionalidad
	) {}