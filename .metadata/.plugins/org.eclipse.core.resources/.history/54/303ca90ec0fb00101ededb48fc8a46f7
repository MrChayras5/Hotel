package com.reservas_commons.dto;

import java.math.BigDecimal;

import jakarta.validation.constraints.Email;
import jakarta.validation.constraints.Max;
import jakarta.validation.constraints.Min;
import jakarta.validation.constraints.NotBlank;
import jakarta.validation.constraints.NotNull;
import jakarta.validation.constraints.Positive;
import jakarta.validation.constraints.Size;

public record HuespedRequest(
		
		@NotNull(message = "El número de habitación es obligatorio")
		@Positive(message = "El número del id Huesped debe ser positivo")
		Long idHuesped,
		
		@NotBlank(message = "El nombre es  obligatorio")
		@Size(max = 20, message = "El nombre no puede exceder 50 caracteres")
		String nombre,
		
		@NotBlank(message = "El apellido es  obligatorio")
		@Size(max = 20, message = "El apellido no puede exceder 50 caracteres")
		String apellido,

		@NotBlank(message = "El email es  obligatorio")
		@Email(message = "El email debe de ser valido")
		@Size(max = 20, message = "El email no puede exceder 100 caracteres")
		String email,

		@NotNull(message = "El telefono es obligatorio")
		@Min(value = 10, message = "El telefono es minimo de 10 dijitos")
		@Max(value = 10, message = "El telefono debe tener un max de 10 dijitos")
		String telefono,
		
		@NotNull(message = "La capacidad es obligatoria")
		@Positive(message = "La capacidad debe ser mayor a 0")
		Integer capacidad,
		
		@NotBlank(message = "El estado es obligatorio")
		@Size(max = 20, message = "El estado no puede exceder 20 caracteres")
		String estado
	) {}