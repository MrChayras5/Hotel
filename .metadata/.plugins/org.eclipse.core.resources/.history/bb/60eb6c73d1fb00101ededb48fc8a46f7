package com.huesped.service;

import java.util.List;
import java.util.stream.Collectors;

import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import com.huesped.mapper.HuespedMapper;
import com.huesped.repository.HuespedRepository;
import com.reservas_commons.dto.HuespedRequest;
import com.reservas_commons.dto.HuespedResponse;

import lombok.AllArgsConstructor;
import lombok.extern.slf4j.Slf4j;

@Service
@AllArgsConstructor
@Slf4j

public class HuespedServiceImp implements HuespedService {
	
	private final HuespedMapper huespedMapper;
	private final HuespedRepository huespedRepository;
	

    @Override
    public List<HuespedResponse> listar() {
        return huespedRepository.findAll().stream()
                .map(huespedMapper::entityToResponce)
                .collect(Collectors.toList());
    }

    @Override
    public HuespedResponse registrar(HuespedRequest request) {
        Huesped entity = huespedMapper.toEntity(request);
        return huespedMapper.toResponse(huespedRepository.save(entity));
    }

    @Override
    public HuespedResponse obtenerPorId(Long id) {
        return huespedRepository.findById(id)
                .map(huespedMapper::toResponse)
                .orElseThrow(() -> new RuntimeException("Huésped no encontrado"));
    }
    


    @Override
    public HuespedResponse actualizar(HuespedRequest request, Long id) {
    	// 1. Buscamos el registro existente por su ID
    	return huespedRepository.findById(id).map(huespedExistente -> {
    		// 2. Actualizamos los campos según tu tabla de Oracle
    		huespedExistente.setNombre(request.nombre());
    		huespedExistente.setApellido(request.apellido());
    		huespedExistente.setDocumento(request.documento()); // Mapea a la columna DOCUMENTO si así lo definiste
    		huespedExistente.setTelefono(request.telefono());
    		huespedExistente.setEmail(request.email());
    		
    		// 3. Guardamos los cambios y retornamos la respuesta mapeada
    		Huesped actualizado = huespedRepository.save(huespedExistente);
    		return huespedMapper.toResponse(actualizado);
    	}).orElseThrow(() -> new RuntimeException("No se puede actualizar: Huésped no encontrado con ID: " + id));
    }
    
    
    @Override
    public void eliminar(Long id) {
        // Verificamos existencia antes de borrar para evitar excepciones vacías
        if (!huespedRepository.existsById(id)) {
            throw new RuntimeException("No se puede eliminar: Huésped no encontrado con ID: " + id);
        }
        huespedRepository.deleteById(id);
    }

}
